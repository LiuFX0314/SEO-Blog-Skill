{
  "tools": [
    {
      "name": "generate_b2b_seo_blog",
      "description": "Generate a full B2B SEO-optimized blog including strategy, outline, article, SEO metadata, and conversion elements.",
      "executor": "bash",
      "command": "node handlers/generate_b2b_seo_blog.js --keyword \"{{keyword}}\" --audience \"{{audience}}\" --length {{length}} --goal \"{{goal}}\" --region \"{{region}}\" --tone \"{{tone}}\"",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "Main SEO keyword or topic"
          },
          "audience": {
            "type": "string",
            "description": "Target audience (e.g., engineers, distributors, procurement managers)"
          },
          "length": {
            "type": "integer",
            "description": "Target word count (e.g., 1000, 1500, 2000)"
          },
          "goal": {
            "type": "string",
            "enum": ["traffic", "lead_generation", "authority"],
            "description": "Primary blog goal"
          },
          "region": {
            "type": "string",
            "description": "Target market (e.g., global, US, Europe, Southeast Asia)"
          },
          "tone": {
            "type": "string",
            "description": "Writing tone (e.g., professional, technical, persuasive)"
          }
        },
        "required": ["keyword", "audience", "length"]
      }
    }
  ]
}
